---
export interface Props {
  title: string;
  description: string;
  jsonld?: string | string[];
  canonicalPath?: string;
}

const { title, description, jsonld, canonicalPath = Astro.url.pathname } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site).href;
const blocks = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const wa = 'https://wa.me/5531991633453';
const path = Astro.url.pathname;

const GTM_ID = 'GTM-MZSFFL6K';

// Contexto de página para o dataLayer (GTM / GA4 content_group)
let pageType = 'outra';
let serviceSlug: string | null = null;
let regionSlug: string | null = null;
if (path === '/') pageType = 'home';
else if (path === '/blog/') pageType = 'blog_index';
else if (path.startsWith('/blog/')) pageType = 'blog_post';
else if (path === '/sobre/') pageType = 'institucional';
else if (path === '/contato/') pageType = 'contato';
else if (path.startsWith('/vidracaria-em-')) {
  pageType = 'regiao';
  regionSlug = path.replace(/\//g, '').replace('vidracaria-em-', '');
} else if (/-bh\/$/.test(path)) {
  pageType = 'servico';
  serviceSlug = path.replace(/\//g, '');
} else if (path === '/404') pageType = '404';

const servicos = [
  ['/box-para-banheiro-bh/', 'Box para banheiro'],
  ['/cortina-de-vidro-bh/', 'Cortina de vidro'],
  ['/fechamento-de-varanda-bh/', 'Fechamento de varanda'],
  ['/envidracamento-de-sacada-bh/', 'Envidraçamento de sacada'],
  ['/espelho-sob-medida-bh/', 'Espelhos sob medida'],
  ['/guarda-corpo-de-vidro-bh/', 'Guarda-corpo de vidro'],
  ['/cobertura-de-vidro-bh/', 'Cobertura de vidro'],
  ['/porta-de-vidro-bh/', 'Porta de vidro'],
  ['/vidro-temperado-bh/', 'Vidro temperado'],
  ['/vidraceiro-bh/', 'Vidraceiro (manutenção)'],
];
const regioes = [
  ['/vidracaria-em-contagem/', 'Contagem'],
  ['/vidracaria-em-betim/', 'Betim'],
  ['/vidracaria-em-nova-lima/', 'Nova Lima'],
  ['/vidracaria-em-vespasiano/', 'Vespasiano'],
  ['/vidracaria-em-lagoa-santa/', 'Lagoa Santa'],
];
const manutencao = [
  ['/vidraceiro-bh/', 'Vidraceiro (visão geral)'],
  ['/manutencao-de-box-de-banheiro-bh/', 'Manutenção de box de banheiro'],
  ['/manutencao-de-porta-de-vidro-bh/', 'Manutenção de porta de vidro'],
  ['/manutencao-de-cortina-de-vidro-bh/', 'Manutenção de cortina de vidro'],
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline define:vars={{ pageType, serviceSlug, regionSlug, pageTitle: title }}>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        page_type: pageType,
        content_group: pageType,
        page_title: pageTitle,
        page_path: location.pathname,
        ...(serviceSlug ? { service: serviceSlug } : {}),
        ...(regionSlug ? { region: regionSlug } : {}),
      });
    </script>
    <!-- Google Tag Manager -->
    <script is:inline define:vars={{ GTM_ID }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', GTM_ID);
    </script>
    <!-- End Google Tag Manager -->

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a4049" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    {blocks.map((b) => <script type="application/ld+json" set:html={b} />)}
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="gtm"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <a class="skip" href="#conteudo">Ir para o conteúdo</a>

    <header class="site-header">
      <div class="wrap hdr">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>Vidraçaria <strong>BH</strong></span>
        </a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden />
        <label for="nav-toggle" class="nav-burger" aria-label="Abrir menu">
          <span></span><span></span><span></span>
        </label>

        <nav class="site-nav" aria-label="Principal">
          <details class="menu">
            <summary>Serviços</summary>
            <div class="menu-panel">
              {servicos.map(([href, label]) => (
                <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
              ))}
            </div>
          </details>
          <details class="menu">
            <summary>Manutenção</summary>
            <div class="menu-panel">
              {manutencao.map(([href, label]) => (
                <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
              ))}
            </div>
          </details>
          <details class="menu">
            <summary>Regiões</summary>
            <div class="menu-panel">
              {regioes.map(([href, label]) => (
                <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
              ))}
            </div>
          </details>
          <a class="nav-link" href="/blog/" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Blog</a>
          <a class="nav-link" href="/sobre/" aria-current={path === '/sobre/' ? 'page' : undefined}>Sobre</a>
          <a class="nav-link" href="/contato/" aria-current={path === '/contato/' ? 'page' : undefined}>Contato</a>
          <a class="wa-btn" href={wa}>WhatsApp</a>
        </nav>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap ft-cols">
        <div class="ft-about">
          <a class="brand brand--footer" href="/">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>Vidraçaria <strong>BH</strong></span>
          </a>
          <p>Vidro sob medida em Belo Horizonte e região, com equipe de instalação própria. Box, cortina de vidro, espelhos, guarda-corpo, cobertura, fachada e manutenção.</p>
          <p class="ft-contact">
            <a href={wa}>WhatsApp (31) 99163-3453</a><br />
            <a href="mailto:contato@vidracariabh.emp.br">contato@vidracariabh.emp.br</a><br />
            Seg a sex, 8h–18h · sáb, 8h–12h · Belo Horizonte/MG · CEP 30160-011
          </p>
        </div>
        <div>
          <p class="ft-title">Serviços</p>
          <ul>{servicos.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
        </div>
        <div>
          <p class="ft-title">Manutenção</p>
          <ul>{manutencao.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
          <p class="ft-title ft-title--gap">Regiões</p>
          <ul>{regioes.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
          <p class="ft-title ft-title--gap">Institucional</p>
          <ul><li><a href="/blog/">Blog</a></li><li><a href="/sobre/">Sobre</a></li><li><a href="/contato/">Contato</a></li></ul>
        </div>
      </div>
      <p class="ft-bottom">
        © {new Date().getFullYear()} Vidraçaria BH · Atendimento a domicílio em Belo Horizonte e região metropolitana
        · <a href="/llms.txt">/llms.txt</a>
        · <a href="/ai-summary">/ai-summary</a>
      </p>
    </footer>

    <a class="fab" href={wa} aria-label="Falar no WhatsApp">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="currentColor"><path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.48 1.34 5L2 22l5.2-1.36a9.9 9.9 0 0 0 4.84 1.24h.01c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2Zm0 18.2h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.09.81.83-3.01-.2-.31a8.24 8.24 0 0 1 12.8-10.2 8.16 8.16 0 0 1 2.4 5.82c0 4.54-3.7 8.24-8.24 8.24Zm4.52-6.17c-.25-.12-1.47-.72-1.7-.8-.23-.09-.4-.13-.56.13-.17.25-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.16.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.42l-.48-.01c-.16 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.16 1.75 2.67 4.25 3.74.59.26 1.06.41 1.42.52.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"/></svg>
    </a>

    <style is:global>
      :root{
        color-scheme: light;
        --bg:#ffffff; --surface:#f3f7f8; --surface-2:#e9eff1;
        --ink:#0c1519; --muted:#586b72; --line:#d8e1e3;
        --brand:#0e5866; --brand-dark:#0a4049; --brand-tint:#e2f0f2;
        --cta:#12a150; --cta-dark:#0d833f;
        --accent:#e0a53c;
        --radius:16px; --radius-sm:11px;
        --shadow-sm:0 1px 2px rgba(10,45,52,.05), 0 4px 14px rgba(10,45,52,.06);
        --shadow-md:0 12px 36px rgba(10,45,52,.14);
        --maxw:66rem;
        --f-body:'Inter',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
        --f-head:'Space Grotesk','Inter',system-ui,sans-serif;
      }
      *,*::before,*::after{ box-sizing:border-box; }
      html{ scroll-behavior:smooth; }
      body{
        margin:0; background:var(--bg); color:var(--ink);
        font-family:var(--f-body); font-size:clamp(1rem,.97rem + .2vw,1.06rem);
        line-height:1.7; -webkit-font-smoothing:antialiased;
      }
      img{ max-width:100%; height:auto; display:block; }
      a{ color:var(--brand); text-underline-offset:2px; }
      a:hover{ color:var(--brand-dark); }
      .wrap{ max-width:var(--maxw); margin-inline:auto; padding-inline:1.25rem; }
      .skip{ position:absolute; left:-999px; top:0; background:var(--brand-dark); color:#fff; padding:.6rem 1rem; border-radius:0 0 8px 0; z-index:100; }
      .skip:focus{ left:0; }

      /* ---------- header ---------- */
      .site-header{ position:sticky; top:0; z-index:40; background:rgba(255,255,255,.92); backdrop-filter:saturate(180%) blur(8px); border-bottom:1px solid var(--line); }
      .hdr{ display:flex; align-items:center; gap:1rem; min-height:64px; }
      .brand{ display:inline-flex; align-items:center; gap:.55rem; font-family:var(--f-head); font-weight:600; font-size:1.15rem; color:var(--ink); text-decoration:none; letter-spacing:-.01em; }
      .brand strong{ color:var(--brand); }
      .brand-mark{ width:20px; height:20px; border-radius:5px; background:linear-gradient(135deg,var(--brand) 40%,#3fb0c0); box-shadow:inset 0 0 0 2px rgba(255,255,255,.55); transform:rotate(45deg); flex:none; }
      .site-nav{ display:flex; align-items:center; gap:.35rem; margin-left:auto; }
      .nav-link, .menu>summary{ font-size:.94rem; padding:.5rem .7rem; border-radius:9px; color:var(--ink); text-decoration:none; cursor:pointer; white-space:nowrap; }
      .nav-link:hover, .menu>summary:hover{ background:var(--surface); }
      .nav-link[aria-current="page"]{ color:var(--brand); font-weight:600; }
      .menu{ position:relative; }
      .menu>summary{ list-style:none; display:inline-flex; align-items:center; gap:.3rem; }
      .menu>summary::-webkit-details-marker{ display:none; }
      .menu>summary::after{ content:""; width:.42rem; height:.42rem; border-right:2px solid currentColor; border-bottom:2px solid currentColor; transform:rotate(45deg) translateY(-1px); opacity:.6; }
      .menu[open]>summary{ background:var(--surface); }
      .menu-panel{ position:absolute; right:0; top:calc(100% + .4rem); background:#fff; border:1px solid var(--line); border-radius:var(--radius-sm); box-shadow:var(--shadow-md); padding:.4rem; min-width:16rem; display:grid; }
      .menu-panel a{ padding:.55rem .7rem; border-radius:8px; color:var(--ink); text-decoration:none; font-size:.94rem; }
      .menu-panel a:hover{ background:var(--brand-tint); color:var(--brand-dark); }
      .menu-panel a[aria-current="page"]{ color:var(--brand); font-weight:600; }
      .wa-btn{ margin-left:.4rem; background:var(--cta); color:#fff; padding:.55rem 1rem; border-radius:999px; text-decoration:none; font-weight:600; font-size:.9rem; box-shadow:var(--shadow-sm); }
      .wa-btn:hover{ background:var(--cta-dark); color:#fff; }
      .nav-burger{ display:none; margin-left:auto; width:44px; height:44px; border-radius:10px; cursor:pointer; }
      .nav-burger span{ display:block; height:2px; width:22px; margin:5px auto; background:var(--ink); border-radius:2px; transition:.2s; }

      @media (max-width:860px){
        .nav-burger{ display:block; }
        .site-nav{ position:absolute; left:0; right:0; top:100%; flex-direction:column; align-items:stretch; gap:.15rem; background:#fff; border-bottom:1px solid var(--line); box-shadow:var(--shadow-md); padding:.6rem 1.25rem 1rem; max-height:0; overflow:hidden; visibility:hidden; }
        .nav-toggle:checked ~ .site-nav{ max-height:80vh; overflow:auto; visibility:visible; padding-block:.8rem 1.1rem; }
        .nav-toggle:checked ~ .nav-burger span:nth-child(1){ transform:translateY(7px) rotate(45deg); }
        .nav-toggle:checked ~ .nav-burger span:nth-child(2){ opacity:0; }
        .nav-toggle:checked ~ .nav-burger span:nth-child(3){ transform:translateY(-7px) rotate(-45deg); }
        .nav-link, .menu>summary{ padding:.7rem .4rem; font-size:1rem; }
        .menu-panel{ position:static; box-shadow:none; border:0; border-left:2px solid var(--line); border-radius:0; margin:.1rem 0 .3rem .5rem; padding:.1rem 0; min-width:0; }
        .wa-btn{ margin:.5rem 0 0; text-align:center; }
      }

      /* ---------- generic page ---------- */
      .money-page, .post, .bloglist, .nf{ max-width:var(--maxw); margin-inline:auto; padding:1.75rem 1.25rem 4rem; }
      .post{ max-width:44rem; }
      .crumbs{ font-size:.82rem; color:var(--muted); margin-bottom:1.1rem; }
      .crumbs a{ color:var(--muted); text-decoration:none; }
      .crumbs a:hover{ color:var(--brand); }

      h1{ font-family:var(--f-head); font-weight:700; letter-spacing:-.02em; line-height:1.15; font-size:clamp(1.8rem,1.35rem + 2.1vw,2.7rem); margin:.2rem 0 .9rem; }
      .money-page h2, .post-body h2{ font-family:var(--f-head); font-weight:600; letter-spacing:-.01em; font-size:clamp(1.3rem,1.15rem + .8vw,1.7rem); margin:2.8rem 0 .9rem; padding-bottom:.45rem; border-bottom:1px solid var(--line); }
      .money-page h3, .post-body h3{ font-family:var(--f-head); font-weight:600; font-size:1.08rem; margin:1.7rem 0 .4rem; }
      p{ margin:0 0 1rem; }
      .money-page ul, .money-page ol, .post-body ul, .post-body ol{ margin:0 0 1.15rem; padding-left:1.3rem; }
      .money-page li, .post-body li{ margin:.4rem 0; }
      .money-page li::marker, .post-body li::marker{ color:var(--brand); }
      strong{ font-weight:600; }

      .hero{ margin:0 0 1.6rem; }
      .hero img{ width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:var(--radius); box-shadow:var(--shadow-md); }
      @media (max-width:560px){ .hero img{ aspect-ratio:4/3; } }

      /* CTA */
      .cta{ margin:1.6rem 0; color:var(--muted); font-size:.95rem; display:flex; flex-wrap:wrap; align-items:center; gap:.5rem .7rem; }
      .btn{
        display:inline-flex; align-items:center; gap:.5rem;
        background:var(--cta); color:#fff; padding:.85rem 1.35rem; border-radius:999px;
        text-decoration:none; font-weight:600; font-size:1rem; box-shadow:var(--shadow-sm);
        transition:transform .12s ease, background .12s ease;
      }
      .btn::before{ content:""; width:9px; height:9px; border-radius:50%; background:#fff; opacity:.9; box-shadow:0 0 0 4px rgba(255,255,255,.28); }
      .btn:hover{ background:var(--cta-dark); color:#fff; transform:translateY(-1px); }

      /* NAP cards */
      .nap-top, .nap-footer{ background:var(--brand-tint); border:1px solid #cfe6e9; border-left:4px solid var(--brand); border-radius:var(--radius-sm); padding:1.1rem 1.3rem; margin:1.6rem 0; }
      .nap-footer{ margin-top:3.2rem; }
      .nap-top p, .nap-footer p{ margin:.3rem 0; font-size:.95rem; }
      .nap-top strong, .nap-footer strong{ color:var(--brand-dark); }
      .nap-top a, .nap-footer a{ color:var(--brand-dark); font-weight:600; }

      /* tables */
      .table-wrap{ overflow-x:auto; margin:1.2rem 0; border:1px solid var(--line); border-radius:var(--radius-sm); }
      table{ border-collapse:collapse; width:100%; font-size:.94rem; min-width:32rem; }
      th, td{ padding:.7rem .85rem; text-align:left; vertical-align:top; border-bottom:1px solid var(--line); }
      thead th{ background:var(--surface); font-family:var(--f-head); font-weight:600; }
      tbody tr:nth-child(even){ background:var(--surface); }
      tbody tr:last-child td{ border-bottom:0; }

      blockquote{ margin:1.4rem 0; padding:.9rem 1.2rem; background:var(--brand-tint); border-left:4px solid var(--brand); border-radius:var(--radius-sm); color:var(--brand-dark); }

      .placeholder{ color:#b42318; font-style:italic; background:#fff4f2; border:1px dashed #f0b4a8; border-radius:8px; padding:.15rem .4rem; }

      /* related */
      .related{ margin-top:3rem; background:var(--surface); border:1px solid var(--line); border-radius:var(--radius); padding:1.2rem 1.4rem; }
      .related-title{ font-family:var(--f-head); font-weight:600; margin:0 0 .5rem; }
      .related ul{ list-style:none; padding:0; margin:0; display:grid; gap:.35rem; }
      .related li a{ display:inline-flex; align-items:center; gap:.45rem; text-decoration:none; color:var(--brand-dark); font-weight:500; }
      .related li a::before{ content:"→"; color:var(--brand); }
      .related li a:hover{ text-decoration:underline; }

      /* blog list */
      .bloglist > p{ color:var(--muted); max-width:44rem; }
      .posts{ list-style:none; padding:0; margin:2rem 0 0; display:grid; gap:1rem; }
      .posts li a{ display:block; padding:1.3rem 1.4rem; background:#fff; border:1px solid var(--line); border-radius:var(--radius); text-decoration:none; color:inherit; box-shadow:var(--shadow-sm); transition:border-color .15s, transform .12s; }
      .posts li a:hover{ border-color:var(--brand); transform:translateY(-2px); }
      .posts h2{ font-family:var(--f-head); font-weight:600; margin:0 0 .4rem; font-size:1.15rem; border:0; padding:0; }
      .posts p{ margin:0 0 .6rem; color:var(--muted); font-size:.95rem; }
      .date{ font-size:.78rem; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; }

      /* blog post */
      .post-meta{ font-size:.82rem; color:var(--muted); text-transform:uppercase; letter-spacing:.04em; margin-top:-.3rem; }
      .post-body{ margin-top:1.6rem; }
      .post-body :global(img){ border-radius:var(--radius); box-shadow:var(--shadow-sm); }
      .post-cta{ margin:2.4rem 0 1rem; padding:1.3rem 1.4rem; background:var(--brand-tint); border:1px solid #cfe6e9; border-radius:var(--radius); color:var(--brand-dark); }

      /* 404 */
      .nf h2{ font-family:var(--f-head); font-size:1.2rem; margin-top:2rem; }
      .nf ul{ padding-left:1.2rem; }

      /* ---------- footer ---------- */
      .site-footer{ margin-top:5rem; background:var(--brand-dark); color:#cfe1e4; font-size:.92rem; }
      .site-footer a{ color:#eaf5f6; text-decoration:none; }
      .site-footer a:hover{ color:#fff; text-decoration:underline; }
      .ft-cols{ display:grid; grid-template-columns:1.6fr 1fr 1fr; gap:2rem; padding-top:3rem; padding-bottom:1.5rem; }
      .brand--footer{ color:#fff; margin-bottom:.6rem; }
      .brand--footer strong{ color:#7fd0dc; }
      .ft-about p{ margin:.5rem 0; max-width:34ch; color:#bcd6da; }
      .ft-contact{ font-size:.88rem; }
      .ft-title{ font-family:var(--f-head); font-weight:600; text-transform:uppercase; letter-spacing:.08em; font-size:.78rem; color:#8fb9bf; margin:0 0 .5rem; }
      .ft-title--gap{ margin-top:1.2rem; }
      .site-footer ul{ list-style:none; padding:0; margin:0; }
      .site-footer li{ margin:.3rem 0; }
      .ft-bottom{ text-align:center; color:#7fa3a9; border-top:1px solid rgba(255,255,255,.1); margin:0; padding:1.1rem 1.25rem; font-size:.82rem; }
      @media (max-width:760px){ .ft-cols{ grid-template-columns:1fr 1fr; } .ft-about{ grid-column:1/-1; } }
      @media (max-width:460px){ .ft-cols{ grid-template-columns:1fr; } }

      /* floating whatsapp */
      .fab{ position:fixed; right:16px; bottom:16px; z-index:35; width:54px; height:54px; border-radius:50%; background:var(--cta); color:#fff; display:grid; place-items:center; box-shadow:0 8px 24px rgba(10,45,52,.28); }
      .fab:hover{ background:var(--cta-dark); color:#fff; }
      @media (max-width:860px){ .fab{ width:50px; height:50px; right:14px; bottom:14px; } }

      /* ============ institucional: hero band, seções, cards ============ */
      .eyebrow{ font-family:var(--f-head); font-weight:600; text-transform:uppercase; letter-spacing:.14em; font-size:.72rem; color:var(--brand); margin:0 0 .6rem; }
      .eyebrow--light{ color:#8fe0ea; }

      .hero-band{ position:relative; isolation:isolate; overflow:hidden; background:var(--brand-dark); }
      .hero-band-img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:-2; }
      .hero-band-scrim{ position:absolute; inset:0; z-index:-1;
        background:linear-gradient(180deg, rgba(8,40,47,.62) 0%, rgba(8,40,47,.78) 55%, rgba(8,40,47,.92) 100%),
                   radial-gradient(120% 80% at 15% 20%, rgba(8,40,47,.15), rgba(8,40,47,.85)); }
      .hero-band-inner{ padding-block:clamp(3.2rem,2rem + 7vw,6rem); color:#eef7f8; max-width:52rem; }
      .hero-band-inner h1{ color:#fff; font-size:clamp(2rem,1.4rem + 3.2vw,3.3rem); margin:.1rem 0 1rem; }
      .hero-band-lead{ font-size:clamp(1.05rem,1rem + .5vw,1.25rem); color:#cfe6e9; max-width:44ch; }
      .hero-band-actions{ display:flex; flex-wrap:wrap; gap:.8rem; margin:1.6rem 0 1.8rem; }
      .btn--lg{ padding:1rem 1.6rem; font-size:1.05rem; }
      .btn-ghost{ display:inline-flex; align-items:center; padding:1rem 1.4rem; border-radius:999px; border:1.5px solid rgba(255,255,255,.5); color:#fff; text-decoration:none; font-weight:600; }
      .btn-ghost:hover{ background:rgba(255,255,255,.12); color:#fff; }
      .hero-chips{ list-style:none; padding:0; margin:0; display:flex; flex-wrap:wrap; gap:.5rem .6rem; }
      .hero-chips li{ font-size:.82rem; color:#dCEff1; background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.18); padding:.35rem .8rem; border-radius:999px; }

      .trust-bar{ background:var(--brand); color:#eaf7f9; }
      .trust-bar--home{ background:var(--surface); color:var(--muted); border-bottom:1px solid var(--line); }
      .trust-inner{ display:flex; flex-wrap:wrap; gap:.6rem 2rem; padding-block:.9rem; font-size:.86rem; font-weight:500; }
      .trust-inner span{ display:inline-flex; align-items:center; gap:.45rem; }
      .tb-ico{ width:1rem; height:1rem; display:inline-grid; place-items:center; border-radius:50%; background:var(--cta); color:#fff; font-style:normal; flex:none; }
      .tb-ico::before{ content:"✓"; font-size:.66rem; line-height:1; }
      .trust-bar:not(.trust-bar--home) .tb-ico{ background:rgba(255,255,255,.22); }

      .page-shell{ display:contents; }
      .section{ padding-block:clamp(2.6rem,1.8rem + 4vw,4.4rem); }
      .section--tint{ background:var(--surface); border-block:1px solid var(--line); }
      .section-title{ font-family:var(--f-head); font-weight:700; letter-spacing:-.02em; font-size:clamp(1.5rem,1.2rem + 1.4vw,2.1rem); line-height:1.2; margin:0 0 .7rem; border:0; padding:0; }
      .section-lead{ color:var(--muted); max-width:52ch; margin:0 0 2rem; }

      .svc-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(15.5rem,1fr)); gap:1rem; }
      .svc-card{ display:flex; flex-direction:column; gap:.5rem; padding:1.3rem 1.4rem 1.2rem; background:#fff; border:1px solid var(--line); border-radius:var(--radius); text-decoration:none; color:inherit; box-shadow:var(--shadow-sm); transition:transform .12s, border-color .15s, box-shadow .15s; }
      .svc-card:hover{ transform:translateY(-3px); border-color:var(--brand); box-shadow:var(--shadow-md); }
      .svc-ico{ width:30px; height:30px; color:var(--brand); }
      .svc-name{ font-family:var(--f-head); font-weight:600; font-size:1.05rem; color:var(--ink); }
      .svc-desc{ font-size:.9rem; color:var(--muted); line-height:1.55; }
      .svc-go{ margin-top:auto; font-size:.82rem; font-weight:600; color:var(--brand); }

      .steps{ list-style:none; padding:0; margin:0; display:grid; grid-template-columns:repeat(auto-fit, minmax(13rem,1fr)); gap:1rem; counter-reset:s; }
      .steps li{ position:relative; background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:1.4rem 1.3rem 1.2rem; }
      .step-n{ display:grid; place-items:center; width:2rem; height:2rem; border-radius:50%; background:var(--brand); color:#fff; font-family:var(--f-head); font-weight:700; margin-bottom:.7rem; }
      .steps strong{ display:block; font-family:var(--f-head); font-size:1rem; margin-bottom:.3rem; }
      .steps p{ margin:0; font-size:.9rem; color:var(--muted); }

      .grid-2{ display:grid; grid-template-columns:1.5fr 1fr; gap:2.4rem; align-items:start; }
      .check-list{ list-style:none; padding:0; margin:1rem 0 0; display:grid; gap:.6rem; }
      .check-list li{ position:relative; padding-left:1.8rem; }
      .check-list li::before{ content:"✓"; position:absolute; left:0; top:.05rem; width:1.2rem; height:1.2rem; display:grid; place-items:center; font-size:.7rem; border-radius:50%; background:var(--brand-tint); color:var(--brand-dark); font-weight:700; }
      .info-card{ background:var(--brand-dark); color:#dCEff1; border-radius:var(--radius); padding:1.5rem 1.5rem 1.6rem; }
      .info-card-title{ font-family:var(--f-head); text-transform:uppercase; letter-spacing:.1em; font-size:.72rem; color:#8fb9bf; margin:0 0 .8rem; }
      .info-card p{ margin:0 0 .9rem; font-size:.92rem; line-height:1.5; }
      .info-card strong{ color:#fff; }
      .info-card a{ color:#eaf5f6; }
      .info-card .btn{ margin-top:.4rem; }

      .section-more{ margin-top:1.4rem; } .section-more a{ font-weight:600; }
      .chips{ list-style:none; padding:0; margin:0; display:flex; flex-wrap:wrap; gap:.55rem; }
      .chips li a{ display:inline-block; padding:.55rem 1.1rem; border-radius:999px; background:#fff; border:1px solid var(--line); color:var(--brand-dark); text-decoration:none; font-weight:600; font-size:.92rem; box-shadow:var(--shadow-sm); }
      .chips li a:hover{ border-color:var(--brand); background:var(--brand-tint); }

      .faq details{ border:1px solid var(--line); border-radius:var(--radius-sm); margin-bottom:.6rem; background:#fff; overflow:hidden; }
      .faq summary{ cursor:pointer; list-style:none; padding:1rem 1.2rem; font-family:var(--f-head); font-weight:600; font-size:1rem; display:flex; justify-content:space-between; align-items:center; gap:1rem; }
      .faq summary::-webkit-details-marker{ display:none; }
      .faq summary::after{ content:"+"; font-size:1.3rem; color:var(--brand); line-height:1; flex:none; }
      .faq details[open] summary::after{ content:"–"; }
      .faq details[open] summary{ border-bottom:1px solid var(--line); }
      .faq-a{ padding:.9rem 1.2rem 1.1rem; }
      .faq-a p{ margin:0; color:var(--muted); }

      .cta-band{ background:linear-gradient(120deg,var(--brand-dark),var(--brand)); color:#eef7f8; }
      .cta-band-inner{ display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:1.5rem; padding-block:clamp(2.4rem,1.8rem + 3vw,3.6rem); }
      .cta-band-kicker{ font-family:var(--f-head); text-transform:uppercase; letter-spacing:.12em; font-size:.72rem; color:#8fe0ea; margin:0 0 .4rem; }
      .cta-band-title{ font-family:var(--f-head); font-weight:700; color:#fff; font-size:clamp(1.4rem,1.15rem + 1.3vw,2rem); margin:0 0 .4rem; border:0; padding:0; max-width:24ch; }
      .cta-band-sub{ margin:0; color:#cfe6e9; max-width:40ch; }
      .cta-band .btn{ background:#fff; color:var(--brand-dark); }
      .cta-band .btn::before{ background:var(--cta); box-shadow:0 0 0 4px rgba(18,161,80,.25); }
      .cta-band .btn:hover{ background:#eafaf0; color:var(--brand-dark); }

      @media (max-width:820px){
        .grid-2{ grid-template-columns:1fr; }
      }
      @media (max-width:560px){
        .hero-band-actions{ flex-direction:column; align-items:stretch; }
        .hero-band-actions .btn, .hero-band-actions .btn-ghost{ text-align:center; justify-content:center; }
      }
    </style>

    <script is:inline>
      (function () {
        window.dataLayer = window.dataLayer || [];
        function loc(a) {
          if (a.closest('.site-header')) return 'header';
          if (a.closest('.site-footer')) return 'footer';
          if (a.classList.contains('fab')) return 'botao_flutuante';
          if (a.classList.contains('wa-btn')) return 'header';
          if (a.classList.contains('btn')) return 'cta_principal';
          if (a.closest('.post-cta')) return 'blog_cta';
          if (a.closest('.nap-top, .nap-footer')) return 'bloco_contato';
          if (a.closest('.related')) return 'servicos_relacionados';
          return 'texto';
        }
        document.addEventListener(
          'click',
          function (e) {
            var a = e.target.closest && e.target.closest('a[href]');
            if (!a) return;
            var href = a.getAttribute('href') || '';
            var l = loc(a);
            if (href.indexOf('wa.me') > -1 || href.indexOf('api.whatsapp.com') > -1) {
              window.dataLayer.push({
                event: 'whatsapp_click',
                lead_channel: 'whatsapp',
                link_location: l,
                link_url: href,
                page_path: location.pathname,
              });
            } else if (href.indexOf('mailto:') === 0) {
              window.dataLayer.push({ event: 'email_click', lead_channel: 'email', link_location: l, page_path: location.pathname });
            } else if (href.indexOf('tel:') === 0) {
              window.dataLayer.push({ event: 'phone_click', lead_channel: 'telefone', link_location: l, page_path: location.pathname });
            } else if (href.indexOf('instagram.com') > -1) {
              window.dataLayer.push({ event: 'social_click', social_network: 'instagram', link_location: l, page_path: location.pathname });
            } else if (l === 'servicos_relacionados' || (a.closest('main') && href.charAt(0) === '/')) {
              window.dataLayer.push({ event: 'internal_link_click', link_location: l, link_url: href, page_path: location.pathname });
            }
          },
          { passive: true }
        );
      })();
    </script>
  </body>
</html>
