---
export interface Props {
  title: string;
  description: string;
  /** JSON-LD string(s) já serializadas. O Link Flow injeta LocalBusiness/Service/Person aqui. */
  jsonld?: string | string[];
  /** rota canônica, ex: "/box-para-banheiro-bh/" */
  canonicalPath?: string;
}

const { title, description, jsonld, canonicalPath = Astro.url.pathname } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site).href;
const blocks = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const wa = 'https://wa.me/5531991633453';
const path = Astro.url.pathname;

const servicos = [
  ['/box-para-banheiro-bh/', 'Box para banheiro'],
  ['/cortina-de-vidro-bh/', 'Cortina de vidro'],
  ['/fechamento-de-varanda-bh/', 'Fechamento de varanda'],
  ['/envidracamento-de-sacada-bh/', 'Envidraçamento de sacada'],
  ['/espelho-sob-medida-bh/', 'Espelhos sob medida'],
  ['/guarda-corpo-de-vidro-bh/', 'Guarda-corpo de vidro'],
  ['/cobertura-de-vidro-bh/', 'Cobertura de vidro'],
  ['/porta-de-vidro-bh/', 'Porta de vidro'],
  ['/vidro-temperado-bh/', 'Vidro temperado'],
  ['/vidraceiro-bh/', 'Vidraceiro (manutenção)'],
];
const regioes = [
  ['/vidracaria-em-contagem/', 'Contagem'],
  ['/vidracaria-em-betim/', 'Betim'],
  ['/vidracaria-em-nova-lima/', 'Nova Lima'],
  ['/vidracaria-em-vespasiano/', 'Vespasiano'],
  ['/vidracaria-em-lagoa-santa/', 'Lagoa Santa'],
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {blocks.map((b) => <script type="application/ld+json" set:html={b} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Vidraçaria BH</a>
        <nav class="site-nav" aria-label="Principal">
          <details class="menu">
            <summary>Serviços</summary>
            <ul>
              {servicos.map(([href, label]) => (
                <li><a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a></li>
              ))}
            </ul>
          </details>
          <details class="menu">
            <summary>Regiões</summary>
            <ul>
              {regioes.map(([href, label]) => (
                <li><a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a></li>
              ))}
            </ul>
          </details>
          <a href="/blog/" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Blog</a>
          <a href="/sobre/" aria-current={path === '/sobre/' ? 'page' : undefined}>Sobre</a>
          <a href="/contato/" aria-current={path === '/contato/' ? 'page' : undefined}>Contato</a>
        </nav>
        <a class="wa-btn" href={wa}>WhatsApp</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap cols">
        <div>
          <p class="ft-title">Vidraçaria BH</p>
          <p>Vidro sob medida em Belo Horizonte e região, com equipe de instalação própria.</p>
          <p>WhatsApp: <a href={wa}>(31) 99163-3453</a><br />E-mail: <a href="mailto:contato@vidracariabh.emp.br">contato@vidracariabh.emp.br</a></p>
          <p>Seg a sex, 8h–18h · sáb, 8h–12h · CEP 30160-011 · Belo Horizonte/MG</p>
        </div>
        <div>
          <p class="ft-title">Serviços</p>
          <ul>{servicos.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
        </div>
        <div>
          <p class="ft-title">Regiões</p>
          <ul>{regioes.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
          <p class="ft-title" style="margin-top:1rem">Institucional</p>
          <ul><li><a href="/blog/">Blog</a></li><li><a href="/sobre/">Sobre</a></li><li><a href="/contato/">Contato</a></li></ul>
        </div>
      </div>
      <p class="ft-bottom">© {new Date().getFullYear()} Vidraçaria BH · Belo Horizonte e região metropolitana</p>
    </footer>

    <style is:global>
      .wrap { max-width: 64rem; margin: 0 auto; padding: 0 1.25rem; }
      .site-header { border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent); position: sticky; top: 0; background: Canvas; z-index: 20; }
      .site-header .wrap { display: flex; align-items: center; gap: 1rem; min-height: 60px; flex-wrap: wrap; }
      .brand { font-weight: 700; font-size: 1.1rem; text-decoration: none; color: inherit; }
      .site-nav { display: flex; align-items: center; gap: 1rem; margin-left: auto; flex-wrap: wrap; }
      .site-nav > a { text-decoration: none; color: inherit; font-size: 0.95rem; }
      .site-nav a[aria-current="page"] { font-weight: 700; }
      .menu { position: relative; }
      .menu > summary { cursor: pointer; list-style: none; font-size: 0.95rem; }
      .menu > summary::-webkit-details-marker { display: none; }
      .menu[open] > ul { display: block; }
      .menu > ul { display: none; position: absolute; top: 1.8rem; left: 0; background: Canvas; border: 1px solid color-mix(in srgb, currentColor 20%, transparent); border-radius: 8px; padding: 0.5rem; min-width: 15rem; list-style: none; margin: 0; box-shadow: 0 8px 24px rgba(0,0,0,0.12); }
      .menu > ul li a { display: block; padding: 0.4rem 0.6rem; text-decoration: none; color: inherit; border-radius: 6px; font-size: 0.95rem; }
      .menu > ul li a:hover { background: color-mix(in srgb, currentColor 8%, transparent); }
      .wa-btn { background: #1a7f5a; color: #fff; padding: 0.5rem 0.9rem; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.9rem; }
      .site-footer { margin-top: 4rem; border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent); padding: 2rem 0 1rem; font-size: 0.9rem; }
      .site-footer .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.5rem; }
      .site-footer ul { list-style: none; padding: 0; margin: 0.4rem 0; }
      .site-footer li { margin: 0.25rem 0; }
      .site-footer a { color: inherit; }
      .ft-title { font-weight: 700; margin: 0 0 0.3rem; }
      .ft-bottom { text-align: center; opacity: 0.7; margin-top: 2rem; }
    </style>
  </body>
</html>
