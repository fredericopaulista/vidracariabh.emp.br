<MoneyPage title={title} description={description} jsonld={jsonld} canonicalPath="/box-para-banheiro-bh/">
  <article class="money-page">
    <nav class="crumbs"><a href="/">Início</a> › <span>Box para banheiro em BH</span></nav>

