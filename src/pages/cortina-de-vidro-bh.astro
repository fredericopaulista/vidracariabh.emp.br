  .crumbs a { color: inherit; }
  .hero { margin: 0 0 1.5rem; }
  .hero img { width: 100%; height: auto; border-radius: 12px; display: block; }
  .nap-top, .nap-footer { background: color-mix(in srgb, currentColor 6%, transparent); border-radius: 10px; padding: 1rem 1.25rem; margin: 1.5rem 0; }
  .nap-top p, .nap-footer p { margin: 0.3rem 0; }
  .nap-footer { margin-top: 3rem; }
  .related { margin-top: 2.5rem; }
  .cta { margin: 1.5rem 0; }
  .btn { display: inline-block; background: #1a7f5a; color: #fff; padding: 0.7rem 1.15rem; border-radius: 8px; text-decoration: none; font-weight: 600; margin-right: 0.4rem; }
  .btn:hover { background: #15694a; }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: 0.95rem; }
  th, td { border: 1px solid color-mix(in srgb, currentColor 20%, transparent); padding: 0.6rem 0.75rem; text-align: left; vertical-align: top; }
  th { background: color-mix(in srgb, currentColor 8%, transparent); }
</style>
