---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Página não encontrada | Vidraçaria BH';
const description = 'A página que você procurou não existe ou foi movida.';
---
<BaseLayout title={title} description={description} canonicalPath="/404">
  <section class="nf">
    <h1>Página não encontrada</h1>
    <p>O endereço que você acessou não existe ou foi movido.</p>
    <p>
      Volte para a <a href="/">página inicial</a>, veja os
      <a href="/blog/">artigos do blog</a> ou fale com a gente no
      <a href="https://wa.me/5531991633453">WhatsApp (31) 99163-3453</a>.
    </p>
    <h2>Serviços</h2>
    <ul>
      <li><a href="/box-para-banheiro-bh/">Box para banheiro em BH</a></li>
      <li><a href="/cortina-de-vidro-bh/">Cortina de vidro em BH</a></li>
      <li><a href="/espelho-sob-medida-bh/">Espelhos sob medida em BH</a></li>
      <li><a href="/guarda-corpo-de-vidro-bh/">Guarda-corpo de vidro em BH</a></li>
      <li><a href="/vidraceiro-bh/">Vidraceiro em BH</a></li>
    </ul>
  </section>
</BaseLayout>
<style>
  .nf { max-width: 40rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; line-height: 1.65; }
  .nf h1 { font-size: clamp(1.6rem, 4vw, 2.2rem); }
  .nf h2 { font-size: 1.2rem; margin-top: 2rem; }
  .nf ul { padding-left: 1.2rem; }
  .nf a { color: inherit; }
</style>
