---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const canonical = `https://vidracariabh.emp.br/blog/${post.slug}/`;

const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString().slice(0, 10),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString().slice(0, 10),
  inLanguage: 'pt-BR',
  mainEntityOfPage: canonical,
  author: { '@type': 'Organization', name: 'Vidraçaria BH' },
  publisher: { '@type': 'Organization', name: 'Vidraçaria BH', url: 'https://vidracariabh.emp.br' },
});
---

<BaseLayout title={`${d.title} | Blog Vidraçaria BH`} description={d.description} jsonld={jsonld} canonicalPath={`/blog/${post.slug}/`}>
  <article class="post">
    <nav class="crumbs"><a href="/">Início</a> › <a href="/blog/">Blog</a> › <span>{d.title}</span></nav>
    <h1>{d.title}</h1>
    <p class="post-meta">
      Publicado em {d.pubDate.toLocaleDateString('pt-BR')}
      {d.updatedDate && d.updatedDate.getTime() !== d.pubDate.getTime() && ` · atualizado em ${d.updatedDate.toLocaleDateString('pt-BR')}`}
    </p>
    <div class="post-body">
      <Content />
    </div>
    {d.moneyPage && (
      <p class="post-cta">
        <a class="btn" href={d.moneyPage}>Ver o serviço relacionado</a>
        ou fale no <a href="https://wa.me/5531991633453">WhatsApp (31) 99163-3453</a>.
      </p>
    )}
    <p><a href="/blog/">← Voltar para o blog</a></p>
  </article>
</BaseLayout>

<style>
  .post { max-width: 44rem; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; line-height: 1.7; }
  .crumbs { font-size: 0.85rem; opacity: 0.75; margin-bottom: 1rem; }
  .crumbs a { color: inherit; }
  .post h1 { font-size: clamp(1.7rem, 4vw, 2.3rem); line-height: 1.25; }
  .post-meta { font-size: 0.85rem; opacity: 0.7; }
  .post-body :global(h2) { font-size: 1.35rem; margin-top: 2.2rem; }
  .post-body :global(h3) { font-size: 1.08rem; margin-top: 1.4rem; }
  .post-body :global(blockquote) { border-left: 3px solid color-mix(in srgb, currentColor 30%, transparent); margin: 1.2rem 0; padding: 0.3rem 0 0.3rem 1rem; opacity: 0.9; }
  .post-body :global(img) { border-radius: 10px; }
  .post-cta { margin: 2rem 0; padding: 1rem 1.25rem; background: color-mix(in srgb, currentColor 6%, transparent); border-radius: 10px; }
  .btn { display: inline-block; background: #1a7f5a; color: #fff; padding: 0.6rem 1rem; border-radius: 8px; text-decoration: none; font-weight: 600; margin-right: 0.4rem; }
  .btn:hover { background: #15694a; }
</style>
