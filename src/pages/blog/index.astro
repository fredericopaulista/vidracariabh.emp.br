---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const title = 'Blog | Vidraçaria BH — dicas de vidro, box e espelho';
const description =
  'Guias práticos sobre vidro, box de banheiro, espelhos e envidraçamento: como limpar, tipos de vidro, o que escolher. Blog da Vidraçaria BH.';
---

<BaseLayout title={title} description={description} canonicalPath="/blog/">
  <section class="bloglist">
    <nav class="crumbs"><a href="/">Início</a> › <span>Blog</span></nav>
    <h1>Blog da Vidraçaria BH</h1>
    <p>Guias práticos sobre vidro, box, espelho e envidraçamento — o que funciona, o que evitar e quando chamar um profissional.</p>

    {posts.length === 0 && <p>Ainda não há artigos publicados.</p>}

    <ul class="posts">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.slug}/`}>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="date">{post.data.pubDate.toLocaleDateString('pt-BR')}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .bloglist { max-width: 48rem; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; line-height: 1.65; }
  .crumbs { font-size: 0.85rem; opacity: 0.75; margin-bottom: 1rem; }
  .crumbs a { color: inherit; }
  .bloglist h1 { font-size: clamp(1.7rem, 4vw, 2.3rem); }
  .posts { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1rem; }
  .posts li a { display: block; padding: 1.1rem 1.25rem; border: 1px solid color-mix(in srgb, currentColor 15%, transparent); border-radius: 12px; text-decoration: none; color: inherit; }
  .posts li a:hover { border-color: color-mix(in srgb, currentColor 35%, transparent); }
  .posts h2 { margin: 0 0 0.4rem; font-size: 1.15rem; }
  .posts p { margin: 0 0 0.5rem; opacity: 0.9; font-size: 0.95rem; }
  .date { font-size: 0.8rem; opacity: 0.65; }
</style>
