---
import BaseLayout from '../layouts/BaseLayout.astro';

// Placeholder. A home definitiva sai da arquitetura aprovada na Fase 1 do Link Flow.
const title = 'Vidraçaria BH — vidros e espelhos sob medida em Belo Horizonte e região';
const description =
  'Vidraçaria em Belo Horizonte com atendimento em Contagem, Betim, Nova Lima, Vespasiano e Lagoa Santa. Box para banheiro, fechamento de varanda, espelhos sob medida, guarda-corpo e cobertura de vidro.';
---
<BaseLayout title={title} description={description}>
  <h1>Vidraçaria BH</h1>
  <p>
    Site em construção. As páginas de serviço e o blog serão publicados pelo Link Flow
    (<code>plataforma: astro</code>).
  </p>
  <p>Atendimento: Belo Horizonte, Contagem, Betim, Nova Lima, Vespasiano e Lagoa Santa.</p>
</BaseLayout>
