---
import BaseLayout from '../layouts/BaseLayout.astro';
import hero from '../assets/img/hero-home.jpg';

const title = 'Vidraçaria em Belo Horizonte | Vidraçaria BH';
const description =
  'Vidraçaria em Belo Horizonte e região: box para banheiro, cortina de vidro, espelhos sob medida, guarda-corpo e mais. Atendimento a domicílio. Peça seu orçamento!';
const wa = 'https://wa.me/5531991633453';

const servicos = [
  ['/box-para-banheiro-bh/', 'Box para banheiro', 'Vidro temperado sob medida — de correr, de abrir, de canto ou para banheira.', 'M4 4h16v16H4z M12 4v16'],
  ['/cortina-de-vidro-bh/', 'Cortina de vidro', 'Painéis que deslizam e empilham na lateral para fechar a varanda.', 'M4 4h16v16H4z M8 4v16 M12 4v16 M16 4v16'],
  ['/fechamento-de-varanda-bh/', 'Fechamento de varanda', 'Cortina de vidro, envidraçamento fixo ou guarda-corpo — a gente indica o certo.', 'M3 20h18 M6 20V8l6-4 6 4v12'],
  ['/espelho-sob-medida-bh/', 'Espelhos sob medida', 'Lapidado, bisotado, com LED, bronze ou fumê — banheiro, sala, academia.', 'M7 3h10v18H7z M9 6l6 12'],
  ['/guarda-corpo-de-vidro-bh/', 'Guarda-corpo de vidro', 'Para sacada, escada e mezanino, dentro da NBR 14718.', 'M3 20h18 M5 20V9 M12 20V9 M19 20V9 M3 6h18'],
  ['/cobertura-de-vidro-bh/', 'Cobertura de vidro', 'Vidro laminado sobre área gourmet, corredor e garagem, com controle de calor.', 'M3 12l9-7 9 7 M5 11v9h14v-9'],
  ['/porta-de-vidro-bh/', 'Porta de vidro', 'De correr, pivotante ou blindex, com as ferragens dimensionadas.', 'M6 3h9v18H6z M12 12h.5'],
  ['/envidracamento-de-sacada-bh/', 'Envidraçamento de sacada', 'Janelas de vidro de correr, com vedação em todo o perímetro.', 'M4 4h16v16H4z M4 12h16 M12 4v16'],
  ['/vidro-temperado-bh/', 'Vidro temperado', 'Fornecimento e instalação para tampo, prateleira, divisória e mais.', 'M5 3h14v18H5z M5 9h14'],
  ['/vidraceiro-bh/', 'Vidraceiro (manutenção)', 'Troca de vidro quebrado, regulagem de porta, roldana e ferragem.', 'M14 7l3 3-7 7-3-3z M3 21l4-1 M16 5l3 3'],
];

const regioes = [
  ['/vidracaria-em-contagem/', 'Contagem'],
  ['/vidracaria-em-betim/', 'Betim'],
  ['/vidracaria-em-nova-lima/', 'Nova Lima'],
  ['/vidracaria-em-vespasiano/', 'Vespasiano'],
  ['/vidracaria-em-lagoa-santa/', 'Lagoa Santa'],
];

const faqs = [
  ['A Vidraçaria BH atende o meu bairro?', 'Atendemos toda Belo Horizonte a domicílio, além de Contagem, Betim, Nova Lima, Vespasiano e Lagoa Santa. Se o seu endereço estiver fora dessa área, confirmamos pelo WhatsApp antes de agendar.'],
  ['Vocês cobram a visita ou o orçamento?', 'O orçamento é sem compromisso. A visita para medição é combinada no WhatsApp antes de marcar; qualquer custo, se houver, é informado nesse momento — nunca depois.'],
  ['Em quanto tempo o serviço fica pronto?', 'Depende do tipo de vidro e da agenda, mas o prazo entra por escrito no orçamento, com data de entrega e de instalação. Vidro temperado costuma levar alguns dias porque é feito sob medida.'],
  ['O vidro tem garantia?', 'O vidro temperado vem com certificado do fabricante quando o serviço exige, e a instalação tem garantia de mão de obra. As condições ficam registradas no orçamento aprovado.'],
  ['Não sei qual vidro escolher. Vocês ajudam?', 'Sim. Na visita a gente indica o tipo de vidro conforme o uso, o peso que a peça vai receber e o quanto você quer de privacidade, sempre dentro do seu orçamento.'],
  ['Dá para parcelar o serviço?', 'As formas de pagamento entram no orçamento, incluindo as opções de parcelamento disponíveis no momento. Você aprova sabendo o valor de cada parcela.'],
  ['Fazem serviço em prédio, com regra de horário?', 'Sim. Trabalhamos em apartamento e em área comum de condomínio. Antes da instalação, alinhamos com você o horário permitido pela administração e a forma de acesso.'],
];

const jsonld = [
  JSON.stringify({
    '@context': 'https://schema.org', '@type': 'HomeAndConstructionBusiness', '@id': 'https://vidracariabh.emp.br/#business',
    name: 'Vidraçaria BH',
    description: 'Vidraçaria em Belo Horizonte e região metropolitana. Box para banheiro, cortina de vidro, fechamento de varanda, espelhos sob medida, guarda-corpo, cobertura de vidro e manutenção.',
    url: 'https://vidracariabh.emp.br', telephone: '+55 31 99163-3453', priceRange: '$$',
    address: { '@type': 'PostalAddress', addressLocality: 'Belo Horizonte', addressRegion: 'MG', postalCode: '30160-011', addressCountry: 'BR' },
    areaServed: ['Belo Horizonte', 'Contagem', 'Betim', 'Nova Lima', 'Vespasiano', 'Lagoa Santa'],
    openingHoursSpecification: [
      { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '18:00' },
      { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '12:00' },
    ],
    sameAs: ['https://www.instagram.com/vidracariabh/'],
  }),
  JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', url: 'https://vidracariabh.emp.br', name: 'Vidraçaria BH', inLanguage: 'pt-BR' }),
  JSON.stringify({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  }),
];
---

<BaseLayout title={title} description={description} jsonld={jsonld} canonicalPath="/">
  <section class="hero-band">
    <img class="hero-band-img" src={hero.src} width={hero.width} height={hero.height} alt="Sacada envidraçada e vidros sob medida em apartamento de Belo Horizonte" loading="eager" />
    <div class="hero-band-scrim"></div>
    <div class="wrap hero-band-inner">
      <p class="eyebrow eyebrow--light">Vidraçaria em Belo Horizonte e região</p>
      <h1>Vidros, box e espelhos sob medida, instalados por quem mede</h1>
      <p class="hero-band-lead">
        A Vidraçaria BH atende a domicílio em Belo Horizonte e na região metropolitana. Medição técnica no local, vidro temperado e orçamento fechado antes de qualquer compromisso.
      </p>
      <div class="hero-band-actions">
        <a class="btn btn--lg" href={wa}>Pedir orçamento no WhatsApp</a>
        <a class="btn-ghost" href="#servicos">Ver serviços</a>
      </div>
      <ul class="hero-chips">
        <li>Atende BH + Contagem, Betim, Nova Lima, Vespasiano, Lagoa Santa</li>
        <li>Seg a sex, 8h–18h · sáb, 8h–12h</li>
        <li>Sem loja física — custo menor no orçamento</li>
      </ul>
    </div>
  </section>

  <section class="trust-bar trust-bar--home">
    <div class="wrap trust-inner">
      <span><i class="tb-ico tb-clock"></i> 7 anos de atuação</span>
      <span><i class="tb-ico tb-team"></i> Equipe de instalação própria</span>
      <span><i class="tb-ico tb-ruler"></i> Medição técnica no local</span>
      <span><i class="tb-ico tb-doc"></i> Orçamento fechado por escrito</span>
    </div>
  </section>

  <div class="home">
    <section id="servicos" class="section">
      <div class="wrap">
        <p class="eyebrow">Serviços</p>
        <h2 class="section-title">O que a Vidraçaria BH faz em Belo Horizonte</h2>
        <p class="section-lead">Atende quem está em obra ou reforma e quer o vidro no projeto, e também quem só precisa resolver um ponto. Cada página tem os tipos de vidro, o prazo e os cuidados.</p>
        <div class="svc-grid">
          {servicos.map(([href, nome, desc, d]) => (
            <a class="svc-card" href={href}>
              <svg class="svc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d} /></svg>
              <span class="svc-name">{nome}</span>
              <span class="svc-desc">{desc}</span>
              <span class="svc-go">Ver detalhes →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow">Manutenção e assistência técnica</p>
        <h2 class="section-title">Vidro quebrado, box ou porta com problema?</h2>
        <p class="section-lead">A Vidraçaria BH também conserta o que já está instalado — troca de vidro, roldana, borracha, mola e ferragem. Manda uma foto no WhatsApp que a gente prioriza.</p>
        <div class="svc-grid">
          <a class="svc-card" href="/manutencao-de-box-de-banheiro-bh/">
            <svg class="svc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v16H4z M4 9h16 M8 4v5" /></svg>
            <span class="svc-name">Manutenção de box de banheiro</span>
            <span class="svc-desc">Box vazando, saindo do trilho ou com a porta pesada. Troca de roldana, borracha e vidro.</span>
            <span class="svc-go">Ver detalhes →</span>
          </a>
          <a class="svc-card" href="/manutencao-de-porta-de-vidro-bh/">
            <svg class="svc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h9v18H6z M12 12h.5 M15 20h3" /></svg>
            <span class="svc-name">Manutenção de porta de vidro</span>
            <span class="svc-desc">Porta raspando, batendo ou que não fecha. Regulagem e troca de mola, pivô e fechadura.</span>
            <span class="svc-go">Ver detalhes →</span>
          </a>
          <a class="svc-card" href="/manutencao-de-cortina-de-vidro-bh/">
            <svg class="svc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v16H4z M8 4v16 M12 4v16 M16 4v16 M4 8h16" /></svg>
            <span class="svc-name">Manutenção de cortina de vidro</span>
            <span class="svc-desc">Cortina travando ou entrando água. Ajuste de trilho, troca de roldana e vedação.</span>
            <span class="svc-go">Ver detalhes →</span>
          </a>
        </div>
        <p class="section-more"><a href="/vidraceiro-bh/">Ver todos os serviços de vidraceiro e assistência técnica →</a></p>
      </div>
    </section>

    <section class="section section--tint">
      <div class="wrap">
        <p class="eyebrow">Como funciona</p>
        <h2 class="section-title">Do WhatsApp à instalação, em 4 passos</h2>
        <ol class="steps">
          <li><span class="step-n">1</span><strong>Contato pelo WhatsApp</strong><p>Você manda o serviço, uma foto do local e o bairro. Recebe orientação e uma faixa de valor no mesmo dia útil.</p></li>
          <li><span class="step-n">2</span><strong>Visita e medição</strong><p>Um profissional vai até você medir o vão, conferir prumo e nível e alinhar o acabamento.</p></li>
          <li><span class="step-n">3</span><strong>Orçamento fechado</strong><p>Preço com o tipo de vidro, as ferragens, o prazo e a forma de pagamento. Nada fica "a confirmar".</p></li>
          <li><span class="step-n">4</span><strong>Instalação e teste</strong><p>A equipe instala, testa a peça na sua frente e explica a limpeza e a manutenção.</p></li>
        </ol>
      </div>
    </section>

    <section class="section">
      <div class="wrap grid-2">
        <div>
          <p class="eyebrow">Por que a Vidraçaria BH</p>
          <h2 class="section-title">Quem mede é quem instala</h2>
          <p>Não terceirizamos a instalação. Isso corta a maior causa de retrabalho em vidraçaria: medida errada passada de uma pessoa para outra.</p>
          <ul class="check-list">
            <li>Medição técnica no local, com conferência de prumo e nível</li>
            <li>Vidro temperado com certificado do fabricante quando o serviço exige</li>
            <li>Prazo por escrito no orçamento, com data de entrega e instalação</li>
            <li>Atendimento a domicílio em BH e região, de segunda a sábado</li>
            <li>Ficha técnica para a administração de condomínio, quando a fachada exige</li>
          </ul>
        </div>
        <aside class="info-card">
          <p class="info-card-title">Atendimento</p>
          <p><strong>WhatsApp</strong><br /><a href={wa}>(31) 99163-3453</a></p>
          <p><strong>E-mail</strong><br /><a href="mailto:contato@vidracariabh.emp.br">contato@vidracariabh.emp.br</a></p>
          <p><strong>Horário</strong><br />Seg a sex, 8h–18h · sáb, 8h–12h</p>
          <p><strong>Base</strong><br />Belo Horizonte / MG · CEP 30160-011</p>
          <a class="btn" href={wa}>Falar agora</a>
        </aside>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow">O que dizem os clientes</p>
        <h2 class="section-title">Clientes da Vidraçaria BH em Belo Horizonte</h2>
        <p class="section-lead">Depoimentos de clientes atendidos a domicílio em BH e região.</p>
        <div class="quote-grid">
          <figure class="quote-card">
            <p>“Pesquisei algumas vidraçarias em Belo Horizonte antes de contratar e escolhi a Vidraçaria BH para instalar o box do meu banheiro. O atendimento foi rápido, o orçamento veio sem complicação e a instalação ficou muito bem feita. Tudo foi entregue dentro do prazo combinado.”</p>
            <figcaption>Carlos Henrique — Castelo, Belo Horizonte</figcaption>
          </figure>
          <figure class="quote-card">
            <p>“Estava procurando uma vidraçaria na região Centro-Sul de BH para fazer um espelho sob medida para a sala. Recebi o orçamento rapidamente e a instalação foi feita na data marcada. O acabamento ficou excelente.”</p>
            <figcaption>Fernanda Oliveira — Sion, Belo Horizonte</figcaption>
          </figure>
          <figure class="quote-card">
            <p>“Contratei o fechamento de varanda em vidro para minha casa no Santa Amélia. Desde a visita para medição até a instalação final, o atendimento foi profissional. O serviço ficou exatamente como eu imaginava e valorizou bastante o ambiente.”</p>
            <figcaption>Ricardo Almeida — Santa Amélia, Belo Horizonte</figcaption>
          </figure>
          <figure class="quote-card">
            <p>“Recebi indicação da Vidraçaria BH para instalar guarda-corpo de vidro na área externa da minha casa. O serviço foi realizado com segurança e atenção aos detalhes. Gostei da transparência durante todo o processo.”</p>
            <figcaption>Eduardo Mendes — Pampulha, Belo Horizonte</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section section--tint">
      <div class="wrap">
        <p class="eyebrow">Regiões atendidas</p>
        <h2 class="section-title">Belo Horizonte e região metropolitana</h2>
        <p class="section-lead">Atendemos a domicílio em toda BH — Centro, Savassi, Buritis, Pampulha, Barreiro, Venda Nova — e nas cidades vizinhas:</p>
        <ul class="chips">
          {regioes.map(([href, nome]) => <li><a href={href}>{nome}</a></li>)}
        </ul>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="eyebrow">Dúvidas frequentes</p>
        <h2 class="section-title">Perguntas frequentes</h2>
        <div class="faq">
          {faqs.map(([q, a]) => (
            <details>
              <summary>{q}</summary>
              <div class="faq-a"><p>{a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  </div>

  <section class="cta-band">
    <div class="wrap cta-band-inner">
      <div>
        <p class="cta-band-kicker">Vidraçaria BH · atendimento a domicílio</p>
        <h2 class="cta-band-title">Peça seu orçamento de vidraçaria em Belo Horizonte</h2>
        <p class="cta-band-sub">Mande uma foto do local e o seu bairro pelo WhatsApp. Sem compromisso.</p>
      </div>
      <a class="btn btn--lg" href={wa}>Falar no WhatsApp (31) 99163-3453</a>
    </div>
  </section>
</BaseLayout>
