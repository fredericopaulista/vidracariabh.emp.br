  JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [
    { '@type': 'Question', name: 'Preciso de autorização do condomínio?', acceptedAnswer: { '@type': 'Answer', text: 'Na maioria dos prédios, sim. O condomínio costuma ter um modelo e uma cor de perfil padrão. Confirme com a administração antes de aprovar o orçamento.' } },
